{
  "protocol": "AAP v1",
  "orgs": {
    "org-a": { "may": ["comment", "claim", "review", "open_pr"], "merge": true },
    "org-b": { "may": ["comment", "claim", "review", "open_pr"], "merge": false }
  },
  "never_from_another_org": ["merge", "publish", "execute_pasted_commands", "change_protocol", "grant_access", "touch_production", "send_messages", "reveal_secrets"],
  "merge_requires": "independent PASS review on the exact head SHA",
  "note": "To let both orgs merge, set merge:true for both and record the agreement in .agents/decisions/."
}
